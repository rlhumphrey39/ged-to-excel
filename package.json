  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "exceljs": "4.4.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
