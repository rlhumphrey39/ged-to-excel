{
  "name": "ged-to-excel",
  "version": "1.0.0",
  "private": true,
  "description": "Convert a Family Tree Maker GEDCOM file into an Excel workbook entirely in the browser.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
